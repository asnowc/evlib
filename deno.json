{
  "name": "@asn/evlib",
  "version": "3.1.4",
  "tasks": {
    "pack": "deno pack --allow-dirty --no-source-maps",
    "build": "deno transpile  src/**/*.ts --outdir dist --declaration",
    "test:coverage": "deno x vitest run --coverage",
    "ci:test": "deno x vitest run",
    "publish:jsr-try": "deno publish --allow-dirty --dry-run",
    "doc:gen": "deno doc --output=temp --html src/core/mod.ts src/async.ts src/data_struct.ts src/math.ts src/object.ts",
    "check-type-src": {
      "command": "deno check --config src/deno.json src",
      "description": "检查 src 目录下的类型"
    },
    "check-type-test": {
      "command": "deno check --config deno.json test",
      "description": "检查测试文件的类型"
    },
    "check-fmt": "deno fmt --check src test"
  },
  "exports": {
    ".": "./src/core/mod.ts",
    "./async": "./src/async.ts",
    "./data_struct": "./src/data_struct.ts",
    "./math": "./src/math.ts",
    "./mock": "./src/mock.ts",
    "./object": "./src/object.ts",
    "./validator": "./src/validator.ts"
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
    "@vitest/coverage-v8": "npm:@vitest/coverage-v8@5.0.1",
    "evlib": "./src/core/mod.ts",
    "evlib/async": "./src/async.ts",
    "evlib/data_struct": "./src/data_struct.ts",
    "evlib/math": "./src/math.ts",
    "evlib/mock": "./src/mock.ts",
    "evlib/object": "./src/object.ts",
    "evlib/validator": "./src/validator.ts",
    "vitest": "npm:vitest@^5.0.1"
  },
  "publish": {
    "include": ["LICENSE", "README.md", "src/**/*.ts"]
  },
  "test": {
    "include": []
  },
  "compilerOptions": { "lib": ["esnext", "deno.window"] },
  "nodeModulesDir": "manual",
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2
  }
}
